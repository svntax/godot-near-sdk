; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Control",
"class": "IntearSelector",
"language": "GDScript",
"path": "res://addons/godot-near-sdk/wallet_selectors/intear_selector.gd"
}, {
"base": "Reference",
"class": "NearConnection",
"language": "GDScript",
"path": "res://addons/godot-near-sdk/NearConnection.gd"
}, {
"base": "Reference",
"class": "WalletConnection",
"language": "GDScript",
"path": "res://addons/godot-near-sdk/WalletConnection.gd"
}, {
"base": "Node",
"class": "WalletProviders",
"language": "GDScript",
"path": "res://addons/godot-near-sdk/WalletProviders.gd"
} ]
_global_script_class_icons={
"IntearSelector": "",
"NearConnection": "",
"WalletConnection": "",
"WalletProviders": ""
}

[application]

config/name="GodotNEARSDK"
run/main_scene="res://addons/godot-near-sdk/test/TestMain.tscn"
config/icon="res://icon.png"

[autoload]

Near="*res://addons/godot-near-sdk/Near.tscn"
CryptoProxy="*res://addons/godot-near-sdk/utils/CryptoProxy.gd"

[mono]

project/assembly_name="GodotNEARSDK"

[physics]

common/enable_pause_aware_picking=true

[rendering]

environment/default_environment="res://default_env.tres"
